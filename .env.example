# --- Shopify Headless ---------------------------------------------------------
# Domain des Shops (ohne https://). Live: shop.doctorbox.eu
NEXT_PUBLIC_SHOPIFY_DOMAIN=shop.doctorbox.eu

# Storefront API Access Token (Settings → Apps → Develop apps → Storefront API)
# Wird nur serverseitig genutzt, um einen Warenkorb zu erstellen und die
# offizielle checkoutUrl zu erhalten. Wenn leer, fällt die Seite automatisch
# auf Shopify Cart-Permalinks zurück (funktioniert auch ohne Token).
SHOPIFY_STOREFRONT_TOKEN=

# Storefront API Version
SHOPIFY_API_VERSION=2025-01
